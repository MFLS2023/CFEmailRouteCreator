(function() {
  // ========== 随机前缀生成（3～9个字母 + 3～5个数字） ==========
  function generateEmailPrefix() {
    const lettersLength = Math.floor(Math.random() * (9 - 3 + 1)) + 3;
    const digitsLength = Math.floor(Math.random() * (5 - 3 + 1)) + 3;
    const letters = Array.from({ length: lettersLength }, () =>
      String.fromCharCode(Math.floor(Math.random() * 26) + 97)
    ).join('');
    const digits = Array.from({ length: digitsLength }, () =>
      Math.floor(Math.random() * 10)
    ).join('');
    return letters + digits;
  }

  // ========== 辅助函数：睡眠 ==========
  function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // ========== 辅助函数：等待元素出现（包含文本） ==========
  async function waitForElementWithText(selector, text, parent = document, timeout = 5000) {
    const startTime = Date.now();
    while (Date.now() - startTime < timeout) {
      const elements = Array.from(parent.querySelectorAll(selector));
      const element = elements.find(el => el.textContent && el.textContent.includes(text));
      if (element) return element;
      await sleep(100);
    }
    throw new Error(`等待元素 ${selector} 包含文本 "${text}" 超时`);
  }

  // ========== 辅助函数：等待元素出现（不检查文本） ==========
  async function waitForElement(selector, timeout = 5000) {
    const startTime = Date.now();
    while (Date.now() - startTime < timeout) {
      const element = document.querySelector(selector);
      if (element) return element;
      await sleep(100);
    }
    throw new Error(`等待元素 ${selector} 超时`);
  }

  // ========== 模拟“原生”输入 ==========
  function simulateInput(element, text) {
    const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
    nativeInputValueSetter.call(element, text);
    element.dispatchEvent(new Event('input', { bubbles: true }));
    element.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // ========== 模拟鼠标点击 ==========
  function simulateMouseClick(element) {
    element.click();
  }

  // ========== 从下拉中选择指定索引选项（默认选第一个） ==========
  async function selectOption(optionIndex = 0) {
    console.log("【下拉选择】点击 React Select 容器...");
    const selectContainer = await waitForElement('.react-select-container');
    simulateMouseClick(selectContainer);
    await sleep(800);

    console.log("【下拉选择】再次点击，以确保下拉菜单打开...");
    simulateMouseClick(selectContainer);
    await sleep(1000);

    console.log("【下拉选择】等待下拉选项出现...");
    let maxAttempts = 10, attempt = 0, selected = false;
    while (!selected && attempt < maxAttempts) {
      attempt++;
      const selectors = [
        '.react-select__option',
        '.react-select__menu-list > div',
        '[role="option"]'
      ];
      for (const sel of selectors) {
        const options = document.querySelectorAll(sel);
        // 如果选项数量大于 optionIndex，就点击对应选项
        if (options.length > optionIndex) {
          console.log(`【下拉选择】找到 ${options.length} 个选项, 选中索引 ${optionIndex}`);
          simulateMouseClick(options[optionIndex]);
          console.log("【下拉选择】已点击目标选项");
          selected = true;
          break;
        }
      }
      if (!selected) {
        console.log(`【下拉选择】第 ${attempt}/${maxAttempts} 次尝试，尚无足够选项，等待并尝试...`);
        await sleep(600);
      }
    }
    if (!selected) {
      console.warn("【下拉选择】尝试多次后仍未选到目标选项，可能下拉无对应选项");
    }
    await sleep(800);
  }

  // ========== 创建单个邮件路由 ==========
  async function createSingleEmailRoute(targetAddress) {
    try {
      // 等待并点击“创建地址”按钮
      const createButton = await waitForElementWithText('button', '创建地址', document, 5000);
      console.log("【邮件路由】点击创建地址按钮...");
      simulateMouseClick(createButton);
      await sleep(1200);

      // 填写自定义前缀
      const prefix = generateEmailPrefix();
      console.log("【邮件路由】填写自定义地址前缀:", prefix);
      const prefixInput = await waitForElement('input[name="customAddress"]');
      simulateInput(prefixInput, prefix);
      await sleep(600);

      // 如果用户提供了 targetAddress，则“输入 + 选第一个下拉候选项”的方式
      if (targetAddress && targetAddress.trim() !== "") {
        console.log("【邮件路由】用户输入目标地址 =>", targetAddress);
        // 点 React Select 容器
        const container = await waitForElement('.react-select-container');
        simulateMouseClick(container);
        await sleep(600);

        // 找到输入框并输入 targetAddress
        const tInput = document.querySelector('.react-select__input');
        if (tInput) {
          simulateInput(tInput, targetAddress);
          // 等下拉候选项刷新
          console.log("【邮件路由】已输入 targetAddress, 等待下拉候选项刷新...");
          await sleep(1000);
          // 然后强行选第一个
          await selectOption(0);
        } else {
          console.warn("【邮件路由】找不到 .react-select__input，可能只能下拉选择默认");
          await selectOption(0);
        }
      } else {
        console.log("【邮件路由】targetAddress为空 => 下拉选择默认第一项");
        await selectOption(0);
      }

      // 再等一会儿，看自定义地址是否还保留
      await sleep(800);
      const prefixInputCheck = document.querySelector('input[name="customAddress"]');
      if (!prefixInputCheck.value || prefixInputCheck.value !== prefix) {
        console.warn("【邮件路由】prefix 丢失了，重新赋值...");
        simulateInput(prefixInputCheck, prefix);
        await sleep(500);
      }

      // 点击保存按钮
      console.log("【邮件路由】尝试点击保存按钮...");
      const allButtons = document.querySelectorAll('button');
      const saveBtn = Array.from(allButtons).find(btn =>
        btn.textContent && btn.textContent.includes("保存")
      );
      if (!saveBtn) {
        throw new Error("没找到【保存】按钮");
      }
      simulateMouseClick(saveBtn);
      console.log("【邮件路由】已点击保存按钮，等待完成...");
      await sleep(2000);

      return prefix;
    } catch (err) {
      console.error("createSingleEmailRoute error:", err);
      throw err;
    }
  }

  // ========== 主函数：创建多个邮件路由 ==========
  async function createEmailRoutes() {
    // 询问创建数量
    const count = parseInt(prompt("请输入要创建的邮箱数量:", "5"));
    if (isNaN(count) || count <= 0) {
      alert("输入无效，请重试!");
      return;
    }
    // 询问邮箱后缀
    let suffix = prompt("请输入邮箱后缀（例如：example.com 或 @example.com）:", "example.com");
    if (!suffix) {
      alert("邮箱后缀不能为空！");
      return;
    }
    if (!suffix.startsWith("@")) {
      suffix = "@" + suffix;
    }
    // 问目标地址
    const targetAddress = prompt("请输入目标地址（留空则直接选下拉第一项）:", "");

    console.log("【createEmailRoutes】数量:", count, "后缀:", suffix, "目标地址:", targetAddress);
    console.log("---------------------------");

    const createdEmails = [];
    let successCount = 0;
    const MAX_RETRIES = 3;

    for (let i = 0; i < count; i++) {
      let attempt = 0, done = false;
      while (!done && attempt < MAX_RETRIES) {
        try {
          attempt++;
          console.log(`【主流程】开始创建第 ${i+1}/${count} 个 (重试:${attempt}/${MAX_RETRIES})...`);
          await waitForElementWithText('button', '创建地址', document, 5000);
          const prefix = await createSingleEmailRoute(targetAddress);
          successCount++;
          createdEmails.push(prefix);
          done = true;
          console.log(`【主流程】第 ${i+1} 个成功 => ${prefix}`);
        } catch (err) {
          console.error(`【主流程】第 ${i+1} 个出错:`, err);
          if (attempt >= MAX_RETRIES) {
            console.error("【主流程】已达最大重试，放弃当前邮箱");
          } else {
            console.warn("【主流程】等待几秒后再重试...");
            await sleep(3000);
          }
        }
      }
      console.log("-------------------");
      await sleep(1000);
    }

    // 结果
    console.log("==== 创建完成报告 ====");
    console.log("总计请求创建:", count);
    console.log("成功创建:", successCount);
    console.log("失败:", count - successCount);

    if (createdEmails.length > 0) {
      console.log("【报告】前缀列表:");
      createdEmails.forEach((p, idx) => {
        console.log(`${idx+1}. ${p}`);
      });
      const fullEmails = createdEmails.map(p => p + suffix);
      console.log("\n【报告】完整邮箱列表：\n```");
      fullEmails.forEach(e => console.log(e));
      console.log("```");
      displayResultInTextArea("完整邮箱列表：\n" + fullEmails.join('\n'));
    }

    console.log("===================");
    if (successCount === count) {
      console.log("✅ 全部创建成功!");
    } else if (successCount === 0) {
      console.log("❌ 全部创建失败!");
    } else {
      console.log("⚠️ 部分创建成功!");
    }
  }

  // ========== 在页面右上角创建 textarea 显示结果，便于复制 ==========
  function displayResultInTextArea(text) {
    const oldTa = document.getElementById("emailResultTA");
    if (oldTa) oldTa.remove();
    const ta = document.createElement('textarea');
    ta.id = "emailResultTA";
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.top = '10px';
    ta.style.right = '10px';
    ta.style.width = '300px';
    ta.style.height = '200px';
    ta.style.zIndex = 9999;
    ta.style.fontSize = '14px';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    console.log("【报告】结果已在右上角文本框展示，可直接复制");
  }

  // ========== 执行主函数 ==========
  createEmailRoutes();
})();
